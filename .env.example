EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_LOCAL_MODE=false

# Supabase Edge Function secrets, set with `supabase secrets set`
OPENAI_API_KEY=
