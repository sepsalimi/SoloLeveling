{
    "name": "solo-leveling-life-analytics",
    "version": "0.1.0",
    "private": true,
    "main": "expo-router/entry",
    "scripts": {
        "start": "expo start",
        "android": "expo start --android",
        "ios": "expo start --ios",
        "web": "expo start --web",
        "lint": "eslint . --ext .ts,.tsx",
        "typecheck": "tsc --noEmit",
        "test": "pnpm test:unit && pnpm test:components",
        "test:unit": "vitest run",
        "test:components": "jest --runInBand",
        "test:watch": "vitest",
        "generate:pwa-icons": "node scripts/generate-pwa-icons.mjs",
        "export:web": "expo export --platform web --output-dir dist && workbox generateSW workbox-config.js"
    },
    "dependencies": {
        "@expo-google-fonts/fraunces": "^0.4.1",
        "@expo-google-fonts/source-sans-3": "^0.4.1",
        "@expo/metro-runtime": "~57.0.8",
        "@expo/vector-icons": "^15.0.0",
        "@react-native-async-storage/async-storage": "2.2.0",
        "@supabase/supabase-js": "^2.110.7",
        "aes-js": "^3.1.2",
        "expo": "~57.0.9",
        "expo-asset": "~57.0.8",
        "expo-audio": "~57.0.3",
        "expo-constants": "~57.0.8",
        "expo-file-system": "~57.0.1",
        "expo-font": "~57.0.1",
        "expo-haptics": "~57.0.1",
        "expo-linking": "~57.0.4",
        "expo-notifications": "~57.0.8",
        "expo-router": "~57.0.9",
        "expo-secure-store": "~57.0.1",
        "expo-sharing": "~57.0.8",
        "expo-splash-screen": "~57.0.5",
        "expo-status-bar": "~57.0.1",
        "expo-system-ui": "~57.0.2",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "react-native": "0.86.2",
        "react-native-chart-kit": "^7.0.2",
        "react-native-gesture-handler": "~2.32.0",
        "react-native-get-random-values": "^1.11.0",
        "react-native-reanimated": "~4.5.1",
        "react-native-safe-area-context": "~5.7.0",
        "react-native-screens": "~4.26.2",
        "react-native-svg": "15.15.4",
        "react-native-web": "^0.21.2",
        "react-native-worklets": "0.10.1",
        "zod": "^4.1.5"
    },
    "devDependencies": {
        "@testing-library/react-native": "^13.3.3",
        "@types/aes-js": "^3.1.4",
        "@types/jest": "^29.5.14",
        "@types/react": "~19.2.0",
        "@types/react-native-get-random-values": "^1.8.2",
        "@typescript-eslint/eslint-plugin": "^8.38.0",
        "@typescript-eslint/parser": "^8.38.0",
        "eslint": "^9.32.0",
        "eslint-config-expo": "~57.0.1",
        "jest-expo": "~57.0.3",
        "react-test-renderer": "19.2.3",
        "sharp": "^0.35.3",
        "typescript": "~6.0.3",
        "vitest": "^3.2.4",
        "workbox-cli": "^7.4.1"
    },
    "packageManager": "pnpm@11.7.0"
}